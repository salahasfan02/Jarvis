{
  "name": "jarvis-desktop",
  "private": true,
  "version": "0.1.0",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepackage": "npm run build --prefix ../frontend && rm -rf renderer && cp -R ../frontend/dist renderer && mkdir -p ~/.jarvis && (cd ../backend && pwd) > ~/.jarvis/backend_path",
    "package": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.jarvis.assistant",
    "productName": "Jarvis",
    "files": ["main.cjs", "overlay.cjs", "quick-preload.cjs", "renderer/**/*"],
    "mac": { "category": "public.app-category.productivity" }
  }
}
